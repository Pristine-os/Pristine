generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  customers Customer[]
  orders    Order[]
  users     User[]
  prices    Price[]
}

model User {
  id             String   @id @default(cuid())
  name           String?
  email          String   @unique
  password       String
  role           String   @default("OWNER")
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Customer {
  id             String   @id @default(cuid())
  firstName      String
  lastName       String
  phone          String
  email          String?
  organizationId String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  orders       Order[]
}

model Order {
  id                 String   @id @default(cuid())
  orderNumber        String   @unique
  status             String   @default("RECEIVED")
  customerId         String
  organizationId     String
  total              Float    @default(0)
  tagPrintingEnabled Boolean  @default(true)
  nextTagNumber      Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer     Customer     @relation(fields: [customerId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  garments     Garment[]
  payments     Payment[]
}

model Garment {
  id             String   @id @default(cuid())
  name           String
  quantity       Int      @default(1)
  service        String
  price          Float    @default(0)
  prepayDiscount Boolean  @default(false)
  printTag       Boolean  @default(true)
  orderId        String
  createdAt      DateTime @default(now())

  order Order        @relation(fields: [orderId], references: [id])
  tags  GarmentTag[]
}

model GarmentTag {
  id        String   @id @default(cuid())
  garmentId String
  tagNumber String   @unique
  sequence  Int
  createdAt DateTime @default(now())

  garment Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)

  @@unique([garmentId, sequence])
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String
  amount    Float
  method    String
  note      String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Price {
  id             String   @id @default(cuid())
  organizationId String
  garmentType    String
  service        String
  price          Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, garmentType, service])
}
